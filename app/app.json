{
  "expo": {
    "name": "Clubalmanac",
    "slug": "clubalmanac-app",
    "owner": "wintvelt",
    "version": "2.0.0",
    "scheme": "clubalmanac",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon/icon-light.png",
    "ios": {
      "bundleIdentifier": "com.wintvelt.clubalmanac-app",
      "supportsTablet": true,
      "icon": "./assets/icon/Clubalmanac.icon",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/literata/600SemiBold/Literata_600SemiBold.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bd5c6c93-059d-409f-bca5-f658ec5722d5"
      }
    }
  }
}
