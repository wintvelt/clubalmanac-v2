{
  "expo": {
    "name": "Clubalmanac",
    "slug": "clubalmanac-app",
    "owner": "wintvelt",
    "version": "2.0.3",
    "scheme": "clubalmanac",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon/icon-light.png",
    "ios": {
      "bundleIdentifier": "com.wintvelt.clubalmanac-app",
      "supportsTablet": true,
      "icon": "./assets/icon/Clubalmanac.icon",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.clubalmanac.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/android-foreground.png",
        "backgroundImage": "./assets/icon/android-background.png",
        "monochromeImage": "./assets/icon/android-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon/icon-light.png",
      "name": "Clubalmanac",
      "lang": "nl"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/literata/600SemiBold/Literata_600SemiBold.ttf"
          ]
        }
      ],
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Clubalmanac gebruikt je foto's en filmpjes alleen om wat jij kiest aan een album toe te voegen, of een foto als profielfoto te gebruiken.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "bd5c6c93-059d-409f-bca5-f658ec5722d5"
      }
    }
  }
}
