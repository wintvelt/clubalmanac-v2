# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Convex generated files: gecommit. Worden geregenereerd door
# `npx convex dev`, en CI heeft geen deploy key nodig om typecheck/tests
# te draaien. Bij schema-wijzigingen: commit de _generated diff mee.

# Env / secrets — NEVER commit
.env
.env.local
.env.*.local
.env.development
.env.production
.env.integration
.env.migrate

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Convex snapshot-exports (data-migration-preflight). Bevat prod-data.
backups/

# Migratie-werkdata (WP12): echte prod-PII + foto's uit AWS. NOOIT committen.
scripts/.data/

# Test coverage
coverage/
.vitest-cache/

# Claude Code local settings (kan user-specifiek zijn)
.claude/settings.local.json
# Worktrees van sessies: eigen kopie van de repo, incl. scripts/.data (foto's). EAS leest
# .git/info/exclude niet, dus zonder deze regel gaan ze mee in de build-upload.
.claude/worktrees/

# WP-Design: screenshots oude app met echte data, niet committen (repo is publiek)
docs/design/oude-app/
